// Copy to Secrets.xcconfig (not in git) and fill in: Supabase → Project Settings → API.
// "$()" keeps the two slashes of the URL (in .xcconfig files "//" starts a comment).
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_...
SUPABASE_LOCAL_URL = http:/$()/127.0.0.1:54321
SUPABASE_LOCAL_KEY = sb_publishable_... (from `supabase status`)
